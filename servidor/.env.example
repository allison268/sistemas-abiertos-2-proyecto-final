# Copia este archivo como .env y llena los valores. El archivo .env NO se sube a GitHub.
PORT=3000
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=memory_honduras
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Modelo que se usa si el principal está ocupado (error 503)
GEMINI_MODEL_RESPALDO=gemini-flash-lite-latest

# Pago real con PayPal (developer.paypal.com > Apps & Credentials)
# PAYPAL_MODE=sandbox para pruebas (dinero ficticio) o live para cobrar de verdad
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal no acepta lempiras: los precios se cobran en dólares con esta tasa
LEMPIRAS_POR_DOLAR=27.07
